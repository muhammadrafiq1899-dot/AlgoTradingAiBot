# Secrets template — copy to .env and fill in. .env is gitignored, never commit it.
# All values here are placeholders; the bot refuses to start in live mode without keys.

# --- Telegram ---
# Token from @BotFather. Keep private.
TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs allowed to control the bot (allowlist).
# Example: TELEGRAM_ALLOWED_USERS=123456789,987654321
TELEGRAM_ALLOWED_USERS=

# --- Binance (only required for live mode; paper mode works without keys) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=
# Optional: separate keys for paper/testnet (Binance spot testnet):
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# --- AI layer (OpenAI-compatible cloud API) ---
# Leave AI_API_KEY empty to run the bot without the AI assistant (execution is unaffected).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Set to "true" to run the assistant on the local Hermes Agent CLI instead of an
# external LLM API (no AI_API_KEY needed; `hermes --version` must work).
USE_HERMES=false
# Hermes-only tuning: toolset for the advisory call ("safe" = no terminal/file
# tools, so the assistant stays advisory-only) and per-call timeout in seconds.
HERMES_TOOLSETS=safe
HERMES_TIMEOUT=120

# --- Internal API (optional; see api: block in config/settings.yaml) ---
# Bearer token guarding /status on the internal FastAPI server. /health stays
# open (it only reports mode + heartbeat age, no trading data).
# Leave empty to keep the internal API disabled.
API_TOKEN=
